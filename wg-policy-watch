#!/usr/bin/env bash
#
# wg-policy-watch - reconcile the stored routing policy whenever a WireGuard
#                   client connects.
#
# WHY A WATCHER AND NOT A wg-quick HOOK
#   PostUp/PreDown fire when the INTERFACE comes up, which on a server happens
#   once at boot. They say nothing about a CLIENT connecting hours later. The
#   failure this guards against is exactly that: the tunnel has been up for days,
#   podman or libvirt restarted at some point and rebuilt its chains (dropping
#   the forward rules), and the next client to connect gets a clean handshake and
#   routes nothing. So the trigger has to be the handshake, not the interface.
#
# HOW THIS TRIGGERS
#   Reconciling is idempotent and costs a handful of `iptables -S` reads, so this
#   simply reconciles on EVERY tick rather than trying to tell a genuine client
#   connect apart from WireGuard's routine ~2-minute rekey. That distinction is
#   not reliably observable from `wg show` -- an earlier version of this script
#   only reconciled when a peer had been quiet longer than a staleness threshold,
#   and a real client reconnecting inside that window was silently ignored while
#   the routes stayed broken.
#
#   Handshake timestamps are still tracked, but only to LOG which client caused a
#   repair. Correctness never depends on classifying the event correctly: drift is
#   corrected within one poll interval whether or not anyone connected, which also
#   covers the podman/libvirt-restart case where no client event happens at all.

set -Eeuo pipefail

log() { printf '%s wg-policy-watch: %s\n' "$(date -Is)" "$*"; }
die() { log "$*"; exit 1; }

# ------------------------------------------------- deployed configuration --
# DEPLOY-CONTRACT.md sections 4.1/4.3. Resolution order, and there is no step 4:
#   1. $WG_POLICY_WATCH_ENV   - non-root only, owner-checked. TESTS ONLY.
#   2. ENV_FILE= out of /etc/cockpit-wireguard/install.conf, written by
#      install.sh. The normal path, and the only one on a production host.
#   3. Fail, naming install.conf.
# No "look beside me" step: this file is reached through a symlink into the
# payload, and resolving .env relative to itself would read the dev checkout's
# test .env on a dev install.
INSTALL_CONF="/etc/cockpit-wireguard/install.conf"
declare -A CFG=()

cfg_parse() {
    local file=$1 n=0 line k v
    [[ -r $file ]] || { printf 'wg-policy-watch: cannot read %s\n' "$file" >&2; return 1; }
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z $line || ${line:0:1} == "#" ]] && continue
        [[ $line == *=* ]] || { printf 'wg-policy-watch: %s:%d: not KEY=VALUE\n' "$file" "$n" >&2; return 1; }
        k=${line%%=*}; v=${line#*=}
        k=${k%"${k##*[![:space:]]}"}
        v=${v#"${v%%[![:space:]]*}"}; v=${v%"${v##*[![:space:]]}"}
        [[ $k =~ ^[A-Z][A-Z0-9_]*$ ]] || { printf 'wg-policy-watch: %s:%d: bad key %s\n' "$file" "$n" "$k" >&2; return 1; }
        [[ ${#v} -ge 2 && ${v:0:1} == '"' && ${v: -1} == '"' ]] && v=${v:1:-1}
        case $v in *'$'*|*'`'*) printf 'wg-policy-watch: %s:%d: %s contains $ or ` - no interpolation\n' "$file" "$n" "$k" >&2; return 1 ;; esac
        CFG["$k"]=$v
    done < "$file"
}

cfg_load() {
    local envfile="" conf_env
    if [[ -n ${WG_POLICY_WATCH_ENV:-} ]]; then
        if [[ $EUID -eq 0 ]]; then
            printf 'wg-policy-watch: ignoring WG_POLICY_WATCH_ENV - a root helper is configured by %s only\n' "$INSTALL_CONF" >&2
        elif [[ -O ${WG_POLICY_WATCH_ENV} && -r ${WG_POLICY_WATCH_ENV} ]]; then
            envfile=${WG_POLICY_WATCH_ENV}
        else
            printf 'wg-policy-watch: ignoring WG_POLICY_WATCH_ENV - not a readable file you own\n' >&2
        fi
    fi
    if [[ -z $envfile ]]; then
        cfg_parse "$INSTALL_CONF" || die "no usable $INSTALL_CONF. Run install.sh; a deployed helper does not guess where its configuration lives."
        conf_env=${CFG[ENV_FILE]:-}
        CFG=()
        [[ -n $conf_env ]] || die "$INSTALL_CONF does not set ENV_FILE. Re-run install.sh."
        envfile=$conf_env
    fi
    cfg_parse "$envfile" || die "could not read $envfile"
}

cfg_load

# CODE resolves relative to this script; CONFIG resolves through install.conf.
# They answer different questions - "which payload did I ship with" and "how is
# this host set up" - and that is why the two rules differ. wg-policy is code.
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
WG_POLICY="$(dirname -- "$SELF")/wg-policy"
[[ -x "$WG_POLICY" ]] || WG_POLICY=/usr/local/sbin/wg-policy

INTERVAL="${CFG[WG_POLICY_INTERVAL]:-10}"
STATE="${CFG[WG_POLICY_WATCH_STATE]:-/run/wg-policy-watch.state}"

command -v wg >/dev/null 2>&1 || { log "wg not found"; exit 1; }
[[ -x "$WG_POLICY" ]] || { log "wg-policy not executable at $WG_POLICY"; exit 1; }

# `wg show all dump` emits a 5-field INTERFACE line per device before its
# 9-field PEER lines, and field 2 of that interface line is the device's PRIVATE
# KEY. Filtering on NF>=5 therefore treats the interface as a peer and logs a
# fragment of the private key. Peer lines are the only ones with >=8 fields.
declare -A LAST_HS

# Seed from the current state so a restart of this service does not treat every
# already-connected peer as a fresh connect.
seed() {
    local ifc pub hs
    while read -r ifc pub hs; do
        [[ -n "${pub:-}" ]] || continue
        LAST_HS["$ifc/$pub"]="$hs"
    done < <(wg show all dump 2>/dev/null | awk 'NF>=8 {print $1, $2, $6}')
    log "seeded ${#LAST_HS[@]} peer(s)"
}

reconcile() {
    local why="$1" out
    if out="$("$WG_POLICY" apply 2>&1)"; then
        # only speak up when something actually changed; a no-op reconcile on
        # every connect would bury the real events in noise
        if grep -qE '^\s+\+' <<<"$out"; then
            log "$why -> policy drift corrected:"
            sed 's/^/    /' <<<"$out"
        fi
    else
        log "$why -> wg-policy apply FAILED:"
        sed 's/^/    /' <<<"$out"
    fi
}

seed
# Reconcile once at start: the window this service exists to close may already
# be open when it starts.
reconcile "startup"

while :; do
    # Note who (re)connected, for the log only.
    connected=""
    while read -r ifc pub hs; do
        [[ -n "${pub:-}" ]] || continue
        key="$ifc/$pub"
        prev="${LAST_HS[$key]:-}"
        LAST_HS["$key"]="$hs"
        if [[ -z "$prev" ]]; then
            connected="new peer ${ifc}/${pub:0:12}"
        elif (( hs > prev )) && (( prev == 0 )); then
            connected="first handshake on ${ifc}/${pub:0:12}"
        fi
    done < <(wg show all dump 2>/dev/null | awk 'NF>=8 {print $1, $2, $6}')

    # Reconcile unconditionally: cheap, idempotent, and the only thing that
    # actually guarantees a connecting client finds working routes.
    reconcile "${connected:-periodic}"

    sleep "$INTERVAL"
done
