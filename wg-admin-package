# ------------------------------------------------------------ bundle builds --

build_linux() {
    local conf hooks="/etc/wireguard/wg-undo.sh"
    # The linux conf carries NO "DNS =" line: wg-quick applies DNS through
    # resolvconf(8), which is missing or not running on minimal systems and
    # containers, and its failure tears the tunnel down. wg-undo.sh applies
    # DNS at PostUp instead (resolvectl -> recorded in-place resolv.conf
    # write -> skip with a NOTE), with full undo. Other OS templates keep
    # their DNS handling (e.g. Windows' tunnel service does DNS natively).
    conf="$(sed -E 's|^[[:space:]]*DNS[[:space:]]*=.*$|# DNS deliberately not set here: wg-undo.sh applies it at PostUp with undo|' \
                <<<"$CONF_CONTENT" | inject_hooks "$hooks")"
    add_file "$CONFFILE"    0600 "$conf"                                  none
    add_file "install.sh"   0755 "$(render "$(tpl_linux_install)")"       bash
    add_file "wg-undo.sh"   0755 "$(render "$(tpl_linux_undo)")"          bash
    add_file "uninstall.sh" 0755 "$(render "$(tpl_linux_uninstall)")"     bash
    INSTRUCTIONS="$(render "$(instr_linux)")"
    UNDO_NOTE="$(render "$(undo_linux)")"
}

build_windows() {
    add_file "$CONFFILE"      0600 "$CONF_CONTENT"                        none
    add_file "install.ps1"   0755 "$(render "$(tpl_win_install)")"        ps1
    add_file "down.ps1"      0755 "$(render "$(tpl_win_down)")"           ps1
    add_file "uninstall.ps1" 0755 "$(render "$(tpl_win_uninstall)")"      ps1
    INSTRUCTIONS="$(render "$(instr_windows)")"
    UNDO_NOTE="$(render "$(undo_windows)")"
}

build_freebsd() {
    local conf hooks="/usr/local/etc/wireguard/wg-undo.sh"
    conf="$(inject_hooks "$hooks" <<<"$CONF_CONTENT")"
    add_file "$CONFFILE"    0600 "$conf"                                  none
    add_file "install.sh"   0755 "$(render "$(tpl_bsd_install)")"         sh
    add_file "wg-undo.sh"   0755 "$(render "$(tpl_bsd_undo)")"            sh
    add_file "uninstall.sh" 0755 "$(render "$(tpl_bsd_uninstall)")"       sh
    INSTRUCTIONS="$(render "$(instr_freebsd)")"
    UNDO_NOTE="$(render "$(undo_freebsd)")"
