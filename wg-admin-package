# ----------------------------------------------------------- lint at emit --

# Every generated script is written to a private scratch dir and syntax
# checked BEFORE the JSON is emitted; a failure refuses the whole bundle.
# The .conf is never written here - it holds the private key and contains no
# script to lint.
# NOTE the trap handler must always return 0: under `set -e` a failing last
# command in an EXIT trap overwrites the script's own exit status.
LINT_DIR=""
cleanup() { if [[ -n "$LINT_DIR" ]]; then rm -rf "$LINT_DIR"; fi; }
trap cleanup EXIT

lint_all() {
    local i name lint p rc=0 pwsh_bin=""
    LINT_DIR="$(mktemp -d /tmp/wg-admin-package.XXXXXX)"
    chmod 0700 "$LINT_DIR"

    pwsh_bin="$(command -v pwsh || true)"
    if [[ -z "$pwsh_bin" && -x /snap/bin/pwsh ]]; then pwsh_bin=/snap/bin/pwsh; fi
    if [[ -n "$pwsh_bin" ]] && ! "$pwsh_bin" -NoProfile -NonInteractive -Command 'exit 0' \
            >/dev/null 2>&1; then
        pwsh_bin=""
    fi

    for i in "${!FILE_NAMES[@]}"; do
        lint="${FILE_LINTS[$i]}"
        if [[ "$lint" == "none" ]]; then continue; fi
        name="${FILE_NAMES[$i]}"
        p="$LINT_DIR/$name"
        printf '%s' "${FILE_CONTENTS[$i]}" > "$p"
        case "$lint" in
        bash)
            if bash -n "$p" >&2; then
                err "lint ok: $name (bash -n)"
            else
                err "generated $name FAILS bash -n"
                rc=1
            fi
            ;;
        sh)
            if sh -n "$p" >&2; then
                err "lint ok: $name (sh -n, POSIX)"
            else
                err "generated $name FAILS sh -n"
                rc=1
            fi
            ;;
        ps1)
            if [[ -n "$pwsh_bin" ]]; then
                if PS_LINT_PATH="$p" "$pwsh_bin" -NoProfile -NonInteractive -Command '
                        $t = $null; $e = $null
                        [void][System.Management.Automation.Language.Parser]::ParseFile($env:PS_LINT_PATH, [ref]$t, [ref]$e)
                        if ($e.Count) { $e | ForEach-Object { [Console]::Error.WriteLine($_.Message) }; exit 1 }
                    ' >&2; then
                    err "lint ok: $name (PowerShell parser)"
                else
                    err "generated $name FAILS the PowerShell parser"
                    rc=1
                fi
            else
                err "pwsh not installed on this host: $name was NOT machine-parsed; it is written to the PowerShell 5.1 syntax subset and shipped after manual review only"
            fi
            ;;
        esac
    done

    rm -rf "$LINT_DIR"
    LINT_DIR=""
    if (( rc != 0 )); then
        die "refusing to emit: generated script(s) failed their linter"
    fi
}

# ------------------------------------------------------------------ emission --

# JSON is assembled from the ENVIRONMENT, never from argv: the conf content
# carries the private key, /proc/<pid>/cmdline is world-readable, and
# /proc/<pid>/environ is owner-only. This mirrors wg-admin's use of
# --rawfile for the same reason.
build_files_json() {
    local i
    for i in "${!FILE_NAMES[@]}"; do
        F_NAME="${FILE_NAMES[$i]}" F_MODE="${FILE_MODES[$i]}" \
        F_CONTENT="${FILE_CONTENTS[$i]}" \
            jq -nc '{name: env.F_NAME, mode: env.F_MODE, content: env.F_CONTENT}'
    done
}

emit() {
    build_files_json | OS_="$OS" INSTR_="$INSTRUCTIONS" UNDO_="$UNDO_NOTE" \
        jq -sc '{os: env.OS_, files: ., instructions: env.INSTR_, undo_note: env.UNDO_}'
}

# ---------------------------------------------------------------------- main --

main() {
    local osarg=""
    # wg-admin dispatches "client-package NAME CFG --os X" verbatim: accept
    # and drop the leading verb word.
    if [[ "${1:-}" == "client-package" ]]; then shift; fi

    while (($#)); do
        case "$1" in
            --os)
                [[ $# -ge 2 ]] || die "client-package: --os needs a value"
                osarg="$2"; shift 2 ;;
            --os=*)
                osarg="${1#--os=}"; shift ;;
            -h|--help)
                usage; exit 0 ;;
            --version)
                jq -nc --arg version "$VERSION" '{version: $version}'; exit 0 ;;
            --) shift ;;
            -*) die "client-package: unknown option: $1" ;;
            *)
                if [[ -z "$NAME" ]]; then NAME="$1"
                elif [[ -z "$CFG" ]]; then CFG="$1"
                else die "client-package: unexpected argument: $1"
                fi
                shift ;;
        esac
    done

    [[ -n "$NAME" && -n "$CFG" ]] || { usage; die "client-package: NAME and CFG are required" 2; }
    valid_name "$NAME" || die "invalid client name: $NAME"
    valid_name "$CFG"  || die "invalid config name: $CFG"
    case "$osarg" in
        linux|windows|freebsd|pfsense|opnsense) OS="$osarg" ;;
        "") die "client-package: --os is required (windows|linux|pfsense|opnsense|freebsd)" ;;
        *)  die "client-package: unsupported --os: $osarg (windows|linux|pfsense|opnsense|freebsd)" ;;
    esac

    need_root
    need_tools jq sed awk tr mktemp

    # ---- read wg-admin's client state (read-only; never modified here) ----
    local d confp
    d="$CLIENTS_DIR/$NAME"
    [[ -d "$d" ]] || die "no such client: $NAME (run new-client first)"
    confp="$d/cfg-${CFG}.conf"
    [[ -f "$confp" ]] || die "no such config: ${NAME}/${CFG} (run add-config first)"
    CONF_CONTENT="$(<"$confp")"

    ENDPOINT="$(conf_field Endpoint)"
    ALLOWED="$(conf_field AllowedIPs)"
    ADDR_IP="$(conf_field Address)"; ADDR_IP="${ADDR_IP%%/*}"
    MTU="$(conf_field MTU)";                     : "${MTU:=$DEFAULT_MTU}"
    DNS="$(conf_field DNS)";                     : "${DNS:=$DEFAULT_DNS}"
    KEEPALIVE="$(conf_field PersistentKeepalive)"; : "${KEEPALIVE:=$DEFAULT_KEEPALIVE}"
    SERVER_PUBKEY="$(conf_field PublicKey)"

    [[ -n "$ENDPOINT" ]]      || die "stored conf ${NAME}/${CFG} has no Endpoint line"
    [[ -n "$ALLOWED" ]]       || die "stored conf ${NAME}/${CFG} has no AllowedIPs line"
    [[ -n "$ADDR_IP" ]]       || die "stored conf ${NAME}/${CFG} has no Address line"
    [[ -n "$SERVER_PUBKEY" ]] || die "stored conf ${NAME}/${CFG} has no PublicKey line"

    ENDPOINT_HOST="${ENDPOINT%:*}"
    ENDPOINT_PORT="${ENDPOINT##*:}"
    if [[ "$ENDPOINT_HOST" == "$ENDPOINT_PLACEHOLDER" ]]; then
        err "warning: the stored conf still carries ${ENDPOINT_PLACEHOLDER}; replace it before deploying this bundle"
    fi

    ALLOWED_SPACED="$(printf '%s' "$ALLOWED" | tr ',' ' ' | tr -s ' ' \
                      | sed 's/^ //; s/ $//')"

    local c
    ROUTE_LIST=""
    for c in $ALLOWED_SPACED; do
        if [[ "$c" == "$TUNNEL_CIDR" || "$c" == "0.0.0.0/0" ]]; then continue; fi
        if [[ -z "$ROUTE_LIST" ]]; then ROUTE_LIST="$c"; else ROUTE_LIST="$ROUTE_LIST, $c"; fi
    done
    [[ -n "$ROUTE_LIST" ]] \
        || ROUTE_LIST="(none needed - every destination is on the tunnel network itself)"

    # ---- derived names ----
    BASE="${NAME}-${CFG}"
    BASE_EFF="$BASE"
    IFACE="$BASE"
    if (( ${#IFACE} > 15 )); then
        IFACE="${IFACE:0:15}"
        err "interface name truncated to '${IFACE}' (Linux IFNAMSIZ limit)"
    fi
    if [[ "$OS" == "windows" && ${#BASE} -gt 32 ]]; then
        BASE_EFF="${BASE:0:32}"
        err "Windows tunnel name truncated to '${BASE_EFF}' (32-char service limit)"
    fi
    CONFFILE="${BASE_EFF}.conf"

    case "$OS" in
        linux)    build_linux ;;
        windows)  build_windows ;;
        freebsd)  build_freebsd ;;
        pfsense)  build_pfsense ;;
        opnsense) build_opnsense ;;
    esac

    lint_all
    emit
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
